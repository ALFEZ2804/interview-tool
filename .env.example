# Copy this file to .env and fill in local values. Never commit .env.
# Next.js and the Prisma CLI both read this environment file.

# OpenAI transcript analysis
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Defaults to gpt-4o-mini in the application.
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL connection string (for example, a Neon pooled connection).
DATABASE_URL="postgresql://user:password@host.example.com/neondb?sslmode=require"

# Shared secret for the optional automated ingestion endpoint.
# Generate with: openssl rand -hex 32
INGEST_SECRET=replace-with-a-long-random-secret

# Google OAuth for sign-in and optional Drive ingestion.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# 32-byte hexadecimal key used to encrypt Google refresh tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=replace-with-64-hex-characters

# Session signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret

# Optional email-domain allowlist. Set this to a domain you control.
# Leave blank only for a local test restricted to Google OAuth test users.
ALLOWED_EMAIL_DOMAIN=example.com

# Optional comma-separated list of admin email addresses.
ADMIN_EMAILS=you@example.com

# Optional visibility and ingestion settings.
INTERVIEW_VIEW_DAYS=90
INGEST_BACKFILL_DAYS=90
